# 複数デバイス同期バックエンドURL
# wrangler deploy 後に取得できる workers.dev の URL を設定してください
# 例: wss://inventory-sync.YOUR_ACCOUNT.workers.dev
# ローカル開発: ws://localhost:8787
VITE_SYNC_WORKER_URL = wss://inventory-sync.yuya-takaki.workers.dev

# PostHog行動分析（Cloudflare Pagesの環境変数に設定）
# https://app.posthog.com でプロジェクトを作成して取得
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

